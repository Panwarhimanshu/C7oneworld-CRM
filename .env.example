# ---------------------------------------------------------------------------
# C7one Lead Management System - environment configuration
# Copy to .env (or run `npm run setup`, which generates one for you).
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development
PORT=3000

# Public URL the app is served from. Used for the QR code shown at reception.
PUBLIC_BASE_URL=http://localhost:3000

# 64+ random hex chars. Signs OTP hashes. NEVER commit or reuse across environments.
APP_SECRET=

# Branding
APP_NAME=C7oneworld
ORG_NAME=C7oneworld Solutions Private Limited

# Set to the number of reverse proxies in front of the app (e.g. 1 behind Nginx).
# Leave 0 when the app is exposed directly. Wrong values allow IP spoofing.
TRUST_PROXY=0

# SQLite database file
DATABASE_PATH=./data/c7one.db

# --- Sessions ----------------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- OTP ---------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
# Hard caps against SMS pumping / toll fraud
OTP_MAX_PER_DESTINATION_PER_DAY=8
OTP_MAX_PER_IP_PER_HOUR=15
OTP_MAX_GLOBAL_PER_HOUR=300

# Channels offered on the registration form: sms, email or "sms,email"
OTP_CHANNELS=sms,email

# DEVELOPMENT ONLY: makes every OTP this fixed code so you can skip SMS/email.
# Leave empty to disable. The server refuses to start if set in production.
OTP_DEV_BYPASS_CODE=

# Default country dialling code for the mobile field
DEFAULT_COUNTRY_CODE=91

# --- SMS provider: console | twilio | msg91 -------------------------------------
# "console" prints the OTP to the server log. Development only; refused in production.
SMS_PROVIDER=console

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 Flow API. The template must contain a variable named ##otp##.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Email provider: console | smtp ----------------------------------------------
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="C7one <no-reply@example.com>"
